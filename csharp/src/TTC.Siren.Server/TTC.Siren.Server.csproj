<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>TTC.Siren.Server</RootNamespace>
    <AssemblyName>TTC.Siren.Server</AssemblyName>
    <!-- Same GC choice as the engine (Phase 7 hardening L7-1, measured): Server GC, non-concurrent. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TTC.Siren.Core\TTC.Siren.Core.csproj" />
    <ProjectReference Include="..\TTC.Siren.Search\TTC.Siren.Search.csproj" />
    <ProjectReference Include="..\TTC.Siren.Compat\TTC.Siren.Compat.csproj" />
    <ProjectReference Include="..\TTC.Siren.Explain\TTC.Siren.Explain.csproj" />
    <ProjectReference Include="..\TTC.Siren.Engine\TTC.Siren.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cloudflare's published proxy ranges (A-27). Shipped next to the program so that the operator can refresh the file without a new build:
         python tools/refresh_cloudflare_ips.py <path of the deployed file>. Used only when Server:Security:TrustedProxies:UseCloudflareRanges is on. -->
    <Content Include="data\cloudflare-ips.txt" Link="cloudflare-ips.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Review M8-1. The Engine project is a library of this server (and a loopback host for the test tools). Its host files must not end up in the
       server's publish folder: they are not used here, and a second configuration file there would be confusing. The server's own appsettings.json is
       the only one. (The Engine's own file is called engine.appsettings.json, so the duplicate-output error of NETSDK1152 cannot happen.) -->
  <Target Name="DropEngineHostFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_EngineHostFile Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'engine.appsettings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'TTC.Siren.Engine.exe' Or '%(ResolvedFileToPublish.RelativePath)' == 'TTC.Siren.Engine.deps.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'TTC.Siren.Engine.runtimeconfig.json'" />
      <ResolvedFileToPublish Remove="@(_EngineHostFile)" />
    </ItemGroup>
  </Target>

  <!-- Phase 8B: the web UI (web/, React + TypeScript + Vite) is built and published as wwwroot next to the program, where the server finds it by itself.
       It needs Node 22 and npm (docs/DEPLOY_WINDOWS.md section 2a). On a build machine without Node, or to publish the API alone: dotnet publish ... -p:SkipWebUi=true.
       Only a publish builds it; a plain build and the tests do not. The dependencies are installed (npm ci, from the lock file) only when web/node_modules is missing. -->
  <PropertyGroup>
    <WebDir>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\web'))'))</WebDir>
  </PropertyGroup>

  <Target Name="BuildWebUi" Condition="'$(SkipWebUi)' != 'true'">
    <Error Condition="!Exists('$(WebDir)package.json')" Text="The web UI was not found at $(WebDir). Publish the API alone with -p:SkipWebUi=true." />
    <Exec Condition="!Exists('$(WebDir)node_modules')" WorkingDirectory="$(WebDir)" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(WebDir)" Command="npm run build" />
  </Target>

  <Target Name="AddWebUiToPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="BuildWebUi" Condition="'$(SkipWebUi)' != 'true'">
    <ItemGroup>
      <_WebUiFile Include="$(WebDir)dist\**\*" />
      <ResolvedFileToPublish Include="@(_WebUiFile)" RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
