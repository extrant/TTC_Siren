{
  "name": "ttc-siren-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web UI of the TTC Siren server (Phase 8B): React + TypeScript + three.js through react-three-fiber, built with Vite and served by the C# server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "node scripts/build-cards.mjs && node scripts/build-mascot.mjs",
    "dev": "npm run data && vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "build": "npm run data && npm run typecheck && vite build",
    "test": "node scripts/build-cards.mjs && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
